# Contrib Compass Environment Variables

# Base URL for the backend API (e.g. deployed Render/Railway/Vercel URL or local Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: GitHub OAuth App Client ID (for direct GitHub authorization screen redirect)
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Force mock mode even if NEXT_PUBLIC_API_URL is set (true/false)
NEXT_PUBLIC_USE_MOCK=false
